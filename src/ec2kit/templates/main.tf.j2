# ==============================================================================
# Generated by ec2kit - AWS EC2 Developer CLI
#
# NOTE: ec2kit is a read-only analysis tool and NEVER modifies terraform state
# or runs `terraform apply`. Review these configurations before applying.
# ==============================================================================

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

{% for top in topologies %}
# ------------------------------------------------------------------------------
# VPC: {{ top.vpc.vpc_id }} ({{ top.vpc.name or 'unnamed' }})
# Import: terraform import aws_vpc.{{ top.tf_name }} {{ top.vpc.vpc_id }}
# ------------------------------------------------------------------------------
resource "aws_vpc" "{{ top.tf_name }}" {
  cidr_block           = "{{ top.vpc.cidr_block }}"
  enable_dns_hostnames = {{ 'true' if top.vpc.enable_dns_hostnames else 'false' }}
  enable_dns_support   = {{ 'true' if top.vpc.enable_dns_support else 'false' }}

  tags = {
    Name = "{{ top.vpc.name or top.tf_name }}"
    ManagedBy = "ec2kit-export"
  }
}

{% for igw in top.internet_gateways %}
# Import: terraform import aws_internet_gateway.{{ igw.tf_name }} {{ igw.igw_id }}
resource "aws_internet_gateway" "{{ igw.tf_name }}" {
  vpc_id = aws_vpc.{{ top.tf_name }}.id

  tags = {
    Name = "{{ igw.igw_id }}"
    ManagedBy = "ec2kit-export"
  }
}
{% endfor %}

{% for sub in top.subnets %}
# Import: terraform import aws_subnet.{{ sub.tf_name }} {{ sub.subnet_id }}
resource "aws_subnet" "{{ sub.tf_name }}" {
  vpc_id                  = aws_vpc.{{ top.tf_name }}.id
  cidr_block              = "{{ sub.cidr_block }}"
  availability_zone       = "{{ sub.availability_zone }}"
  map_public_ip_on_launch = {{ 'true' if sub.is_public else 'false' }}

  tags = {
    Name = "{{ sub.name or sub.subnet_id }}"
    Type = "{{ 'Public' if sub.is_public else 'Private' }}"
    ManagedBy = "ec2kit-export"
  }
}
{% endfor %}

{% for sg in top.security_groups %}
# Import: terraform import aws_security_group.{{ sg.tf_name }} {{ sg.group_id }}
resource "aws_security_group" "{{ sg.tf_name }}" {
  name        = "{{ sg.group_name }}"
  description = "{{ sg.description }}"
  vpc_id      = aws_vpc.{{ top.tf_name }}.id

{% for rule in sg.ingress_rules %}
  ingress {
    description = "{{ rule.description or 'Ingress rule' }}"
    from_port   = {{ rule.from_port if rule.from_port is not none else 0 }}
    to_port     = {{ rule.to_port if rule.to_port is not none else 0 }}
    protocol    = "{{ rule.protocol }}"
    cidr_blocks = [{% if rule.cidr_ipv4 %}"{{ rule.cidr_ipv4 }}"{% endif %}]
  }
{% endfor %}

{% for rule in sg.egress_rules %}
  egress {
    description = "{{ rule.description or 'Egress rule' }}"
    from_port   = {{ rule.from_port if rule.from_port is not none else 0 }}
    to_port     = {{ rule.to_port if rule.to_port is not none else 0 }}
    protocol    = "{{ rule.protocol }}"
    cidr_blocks = [{% if rule.cidr_ipv4 %}"{{ rule.cidr_ipv4 }}"{% endif %}]
  }
{% endfor %}

  tags = {
    Name = "{{ sg.group_name }}"
    ManagedBy = "ec2kit-export"
  }
}
{% endfor %}

{% for inst in top.instances %}
# Import: terraform import aws_instance.{{ inst.tf_name }} {{ inst.instance_id }}
resource "aws_instance" "{{ inst.tf_name }}" {
  ami           = "{{ inst.ami_id }}"
  instance_type = "{{ inst.instance_type }}"
{% if inst.subnet_id %}
  subnet_id     = "{{ inst.subnet_id }}"
{% endif %}

  tags = {
    Name = "{{ inst.name or inst.instance_id }}"
    ManagedBy = "ec2kit-export"
  }
}
{% endfor %}
{% endfor %}
