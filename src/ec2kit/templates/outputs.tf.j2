# Generated by ec2kit - AWS EC2 Developer CLI
# Infrastructure outputs

{% for top in topologies %}
output "vpc_{{ top.tf_name }}_id" {
  description = "VPC ID for {{ top.vpc.vpc_id }}"
  value       = aws_vpc.{{ top.tf_name }}.id
}

{% for inst in top.instances %}
output "instance_{{ inst.tf_name }}_id" {
  description = "Instance ID for {{ inst.instance_id }}"
  value       = aws_instance.{{ inst.tf_name }}.id
}

output "instance_{{ inst.tf_name }}_private_ip" {
  description = "Private IP address for {{ inst.instance_id }}"
  value       = aws_instance.{{ inst.tf_name }}.private_ip
}
{% endfor %}
{% endfor %}
